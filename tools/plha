sub main {
    my $cmd = shift @ARGV or usage();
    my $file = shift @ARGV or usage();
    check_magic($file);
    $controller->{$cmd}->($file, @ARGV);
}

sub usage {
    die "Usage: $0 (v|x|t|d) archive (files)\n v - verbose view of contents\n x - extract archive\n t - test file\n d - dump each header\n";
}

sub open_archive {
    my $fname = shift;
    die "fname missing" unless $fname;
    Archive::Lha::Stream::File->new(file => $fname);
}

sub write_all {
    my ($fname, $data) = @_;
    my $dir = dirname($fname);
    mkpath $dir unless -d $dir;
    open my $fh, '>:raw', $fname or die $!;
    binmode $fh;
    print $fh $data;
    close $fh;
}

sub check_magic {
    my $fname = shift;
    open my $fh, '<:raw', $fname;
    binmode $fh;
    my $magic;
    my $chars = read($fh,$magic,5);
    my ($signature) = unpack("x2a3", $magic);
    die 'Does not look like an LHa file' unless $signature eq "-lh";
}

__END__

=head1 NAME

plha - command line tool to extract .lzh archive

=head1 SYNOPSIS

  # From the command line
  > plha v archive.lzh
  > plha x archive.lzh

  # if you want to extract a specific file from the archive
  > plha x archive.lzh pathname_in_the_archive

=head1 DESCRIPTION

plha is a simple command line tool to extract .lzh archives. It shows file list in an archive, and extracts all the files (or selected files) in the current working directory. No pathname conversion nor content filtering. No parent directory for the extracted files. Use this as a skeleton for your custom command line tool. Patches are welcome.

